{
  "name": "charanatech",
  "version": "0.1.0",
  "private": true,
  "description": "CharanaTech, tienda de accesorios tecnológicos. Powered by OrderHub.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:cov": "pnpm -r --if-present test:cov",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:cov",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
