# Copia este archivo como terraform.tfvars y pon tus valores.
# terraform.tfvars está en .gitignore: el secreto nunca se sube al repo.
google_client_id     = "123456789012-abc123.apps.googleusercontent.com"
google_client_secret = "GOCSPX-..."

# --- Paso 29 ---
# Tu IP pública con /32 (la ves con: curl -s https://checkip.amazonaws.com).
db_allowed_cidrs = ["190.12.34.56/32"]
# openssl rand -hex 20   (40 caracteres: RDS acepta como máximo 41)
db_password = "..."
# La misma INTERNAL_API_KEY de apps/api/.env
internal_api_key = "..."
# La misma STRIPE_SECRET_KEY de apps/api/.env (sk_test_...)
stripe_secret_key = "sk_test_..."

# --- Paso 30 ---
# El secreto del webhook que creas en el Dashboard de Stripe para la URL de la API.
stripe_webhook_secret = "whsec_..."
# La etiqueta de la imagen que subiste a ECR (git rev-parse --short HEAD).
api_image_tag = "abc1234"

# --- Paso 31 ---
# La etiqueta de la imagen de los workers (la imprime scripts/ecr-push.sh workers).
workers_image_tag = "abc1234"

# --- Paso 32 ---
# Quién recibe las alarmas y desde qué correo envía la tienda (puede ser el mismo).
alert_email      = "tu-correo@gmail.com"
ses_sender_email = "tu-correo@gmail.com"
# Opcional: otros correos tuyos que quieras usar para probar compras.
# ses_verified_recipients = ["otro-correo@gmail.com"]
