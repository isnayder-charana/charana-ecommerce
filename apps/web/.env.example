# Dirección de la API (OrderHub). Va al navegador: nunca pongas secretos en NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Inicio de sesión. Debe coincidir con AUTH_MODE de apps/api/.env:
#   "dev"     → botones de usuario de prueba, sin AWS.
#   "cognito" → cuentas reales (correo o Google). Los valores salen de:
#               terraform -chdir=infra/terraform output
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
