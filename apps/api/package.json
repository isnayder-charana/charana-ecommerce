{
  "name": "@charanatech/api",
  "version": "0.1.0",
  "private": true,
  "description": "OrderHub: API de pedidos y catálogo (NestJS, hexagonal + DDD).",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\"",
    "dev": "pnpm build && pnpm --filter . run --parallel \"/^dev:/\"",
    "dev:compile": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" --watch",
    "dev:server": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "pnpm build && node --env-file-if-exists=.env dist/scripts/seed.js",
    "db:tables": "pnpm build && node --env-file-if-exists=.env dist/scripts/create-dynamodb-table.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/client-eventbridge": "3.1164.0",
    "@aws-sdk/client-ssm": "3.1164.0",
    "@aws-sdk/lib-dynamodb": "3.1164.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws-jwt-verify": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2"
  }
}
