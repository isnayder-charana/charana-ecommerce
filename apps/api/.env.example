NODE_ENV=development
PORT=3000

# "dev" acepta tokens de prueba (Authorization: Bearer dev:usuario o dev:usuario:admin).
# "cognito" verifica tokens reales de Amazon Cognito. En producción siempre es "cognito".
AUTH_MODE=dev
# COGNITO_USER_POOL_ID=us-east-2_AbCdEf123  (sale de: terraform -chdir=infra/terraform output)
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ADMIN_GROUP=admin

# "memory": datos de ejemplo en memoria (se pierden al reiniciar).
# "database": MySQL y DynamoDB Local de compose.yaml
#   (antes: pnpm infra:up, pnpm db:deploy, pnpm db:seed y pnpm db:tables).
PERSISTENCE=database
DATABASE_URL=mysql://charanatech:charanatech@localhost:3306/charanatech
# Base para `pnpm test:integration` (se crea sola en el MySQL de compose.yaml).
TEST_DATABASE_URL=mysql://charanatech:charanatech@localhost:3306/charanatech_test
# Paso 33: de dónde salen las fotos al correr `pnpm db:seed` (Next.js sirve
# apps/web/public/products). En AWS es la URL de CloudFront.
PRODUCT_IMAGES_URL=http://localhost:3001/products

# Región de AWS (la misma que LocalStack y Cognito).
AWS_REGION=us-east-2

# DynamoDB (pedidos). DYNAMODB_ENDPOINT solo en local; en AWS se deja vacía.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=charanatech

# Tiendas que pueden llamar a la API desde el navegador (CORS), separadas por coma.
CORS_ORIGINS=http://localhost:3001

# Pagos con Stripe (modo prueba). La clave sale de dashboard.stripe.com → Developers → API keys.
# Solo se aceptan claves de prueba (sk_test_…). Sin clave, "Pagar" responde 503.
# STRIPE_SECRET_KEY=sk_test_...
# Secreto para verificar los webhooks. En local lo imprime `stripe listen` (paso 20).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Dirección de la tienda: Stripe devuelve al cliente ahí después de pagar.
STORE_URL=http://localhost:3001

# Eventos (paso 22). Los pedidos dejan sus eventos en la bandeja (outbox) de DynamoDB
# y un relé los publica en el bus de EventBridge. EVENTBRIDGE_ENDPOINT solo en local
# (LocalStack, paso 21); en AWS se deja vacía. Con PERSISTENCE=memory los eventos
# solo se escriben en el log de la API.
EVENTBRIDGE_ENDPOINT=http://localhost:4566
EVENT_BUS_NAME=charanatech
# Cada cuánto revisa la bandeja el relé (milisegundos). 0 = apagado.
OUTBOX_RELAY_INTERVAL_MS=1000

# Clave compartida con los workers para la ruta /api/internal (paso 25): el almacén
# la usa para avanzar el pedido. La MISMA en apps/workers/.env. Mínimo 32 caracteres.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTERNAL_API_KEY=
