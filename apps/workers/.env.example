# Workers en tu PC: leen las colas de LocalStack (paso 21) y anotan los eventos
# procesados en el DynamoDB Local de compose.yaml. Antes: `pnpm infra:up` en la raíz.
AWS_REGION=us-east-2
SQS_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=charanatech

# Correos (paso 24): SES de LocalStack. Los correos no salen a internet: se ven en
# http://localhost:4566/_aws/ses
SES_ENDPOINT=http://localhost:4566
EMAIL_FROM=no-reply@charanatech.local
# Para el enlace "Ver mi pedido" de los correos.
STORE_URL=http://localhost:3001

# Envío automático (paso 25): el worker fulfillment pide a la API que avance el pedido.
API_URL=http://localhost:3000/api
# La MISMA clave que INTERNAL_API_KEY en apps/api/.env (obligatoria para arrancar).
# INTERNAL_API_KEY=

# Alertas (paso 26): si un mensaje cae en una DLQ, se avisa al tema SNS charanatech-alerts.
# En tu PC el aviso llega a la cola espía charanatech-alerts-log (ver docs/pasos/26).
SNS_ENDPOINT=http://localhost:4566
DLQ_CHECK_SECONDS=30
